# Contact form email delivery (Resend — https://resend.com)
# Server-only secret. Never expose with a NEXT_PUBLIC_ prefix.
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. "Alex Sosa Website <contact@alexsosa.me>"
CONTACT_FROM_EMAIL=
# Optional. Defaults to alexsosa.me@gmail.com
CONTACT_TO_EMAIL=

